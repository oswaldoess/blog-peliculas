# Copia este archivo como .env y llena tus datos. El .env NUNCA se sube a Git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=blog_peliculas

# Genera uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# Duración del token en minutos (720 = 12 horas)
TOKEN_MINUTOS=720

# Bloqueo por fuerza bruta
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO=5

# Orígenes permitidos para CORS (separados por coma). * = cualquiera (solo desarrollo)
CORS_ORIGINS=*
